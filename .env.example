# Lightning configuration for `docker compose` (compose.yaml).
#   cp .env.example .env
# Every variable is optional; the values shown are the defaults.
# Changes apply on the next `docker compose up -d`.

# --- Edge (Caddy) --------------------------------------------------------------

# Public hostname; Caddy obtains and renews its TLS certificate automatically.
# The DNS A/AAAA records must point at this server and ports 80/443 must be open.
# "localhost" serves HTTPS with Caddy's self-signed local CA; ":80" serves plain HTTP.
DOMAIN=localhost

# Contact address for the ACME account (optional). When set, Caddy can also
# fall back to ZeroSSL if Let's Encrypt is unavailable.
ACME_EMAIL=

# Host ports published by the web service.
HTTP_PORT=80
HTTPS_PORT=443

# --- Release -------------------------------------------------------------------

# Image tag for lightning-api, lightning-web and (unless LIGHTNING_RUNTIME_TAG is
# set) the sandbox runtime images: latest (tip of main), sha-<7 chars>, or a
# release such as 1.2.0. Pin it to roll back: scripts/deploy.sh <tag>.
LIGHTNING_VERSION=latest

# Sandbox runtime images: ${LIGHTNING_RUNTIME_IMAGE_PREFIX}<language>:${LIGHTNING_RUNTIME_TAG}
LIGHTNING_RUNTIME_IMAGE_PREFIX=ghcr.io/camilbenameur/lightning-runtime-
# LIGHTNING_RUNTIME_TAG=latest

# Pull missing runtime images in the background when the API starts.
LIGHTNING_PULL_IMAGES=true

# Docker socket on the host (rootless Docker: /run/user/<uid>/docker.sock).
DOCKER_SOCKET=/var/run/docker.sock

# --- Languages and sandbox -----------------------------------------------------

# Comma-separated language ids to enable; empty enables all of them:
# python,javascript,typescript,go,rust,c,cpp,java,ruby,php,bash
LIGHTNING_LANGUAGES=

# OCI runtime for sandbox containers; "runsc" (gVisor) is strongly recommended
# for a public instance once installed (see docs/DEPLOYMENT.md). Empty = runc.
LIGHTNING_SANDBOX_RUNTIME=

# Per-run limits. Some languages get a larger memory limit or a compile-time
# allowance on top of these (see the language registry).
LIGHTNING_RUN_TIMEOUT=10s
LIGHTNING_MEMORY_MB=256
LIGHTNING_CPUS=1.0
LIGHTNING_PIDS_LIMIT=128

# Request and output size limits, in bytes. The output limit applies to
# stdout and stderr combined; the run is killed when it is exceeded.
LIGHTNING_MAX_CODE_BYTES=65536
LIGHTNING_MAX_STDIN_BYTES=65536
LIGHTNING_MAX_OUTPUT_BYTES=65536

# --- Capacity and abuse protection ----------------------------------------------

# Sandboxes running at once, and how long an extra run may wait for a slot
# before getting "503 server_busy". Each sandbox may use up to LIGHTNING_CPUS
# and 256-512 MB of RAM: 4 fits a 2 vCPU / 4 GB server (busy sandboxes share
# the CPUs fairly).
LIGHTNING_MAX_CONCURRENT=4
LIGHTNING_QUEUE_TIMEOUT=20s

# Per-client-IP rate limit on the run endpoints: runs per minute, and burst.
LIGHTNING_RATE_LIMIT=30
LIGHTNING_RATE_BURST=10

# --- Observability -------------------------------------------------------------

# debug, info, warn or error; json (one object per line) or text.
LIGHTNING_LOG_LEVEL=info
LIGHTNING_LOG_FORMAT=json

# --- Cross-origin access ----------------------------------------------------------

# The web UI calls the API on its own origin, so CORS is off. To let other sites
# call https://<DOMAIN>/api/v1 from browsers, list their origins (comma-separated,
# e.g. https://portfolio.example.com) or use * for any origin.
LIGHTNING_CORS_ORIGINS=
